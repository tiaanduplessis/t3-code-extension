{
  "name": "t3-code-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension that sends what you are looking at, with a screenshot, browser details and console errors, to new or existing T3 Code threads.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiaanduplessis/t3-code-extension.git"
  },
  "bugs": {
    "url": "https://github.com/tiaanduplessis/t3-code-extension/issues"
  },
  "homepage": "https://github.com/tiaanduplessis/t3-code-extension#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:contract": "node scripts/contract-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
